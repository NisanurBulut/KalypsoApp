<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Kalypso.Maui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kalypso.Client.ViewModels;assembly=Kalypso.Client"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout>

            <!-- Lagoon banner -->
            <Grid Background="{StaticResource LagoonGradient}" Padding="24,52,24,44" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Text="Settings" FontSize="30" FontAttributes="Bold" TextColor="White" />
                <Label Grid.Row="1" Text="Where does Kalypso sail?" FontSize="14" TextColor="#D9FFFB" />
            </Grid>
            <Image Source="wave_divider.png" Aspect="Fill" HeightRequest="30" Margin="0,-29,0,0" HorizontalOptions="Fill" />

            <Grid Padding="20,0,20,28" MaximumWidthRequest="620" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="18">

                    <Border Style="{StaticResource Card}" Padding="22">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="API address" Style="{StaticResource Heading}" />

                            <Border Style="{StaticResource Field}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Image Source="icon_globe.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding ApiBaseUrl}" Placeholder="http://10.0.2.2:5299" Keyboard="Url" />
                                </Grid>
                            </Border>

                            <Label Style="{StaticResource Hint}"
                                   Text="Android emulator: http://10.0.2.2:5299&#10;Real phone: http://(your PC's IP):5299 on the same Wi-Fi&#10;Deployed API: https://your-api.example.com" />

                            <Label Text="{Binding StatusMessage}" IsVisible="{Binding IsStatusOk}"
                                   TextColor="{StaticResource Success}" FontAttributes="Bold" />
                            <Label Text="{Binding StatusMessage}" IsVisible="{Binding IsStatusError}"
                                   TextColor="{StaticResource Coral}" FontAttributes="Bold" />

                            <Button Text="Test connection" Command="{Binding TestCommand}" Style="{StaticResource GradientButton}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource OutlineButton}" />
                                <Button Grid.Column="1" Text="Use default" Command="{Binding ResetToDefaultCommand}" Style="{StaticResource OutlineButton}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="About" Style="{StaticResource Heading}" />
                            <Label x:Name="VersionLabel" Style="{StaticResource Hint}" />
                            <Label Style="{StaticResource Hint}"
                                   Text="A .NET MAUI client for the Kalypso URL shortener. The app only shows and collects data; all links live in the Kalypso API." />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
